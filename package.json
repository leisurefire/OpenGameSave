{
  "name": "opengamesave",
  "version": "0.7.3",
  "description": "Easily backup and restore your game saves anytime",
  "scripts": {
    "clean": "rimraf dist/out",
    "dev": "npm run tauri -- dev",
    "build": "npm run tauri -- build --no-bundle",
    "start": "npm run tauri -- dev",
    "styles:build": "tailwindcss -i ./src/renderer/styles.css -o ./src/renderer/tailwind-output.css --minify",
    "styles:watch": "tailwindcss -i ./src/renderer/styles.css -o ./src/renderer/tailwind-output.css --watch",
    "test": "node --test test/*.test.js",
    "smoke:desktop": "node scripts/smoke-tauri.cjs",
    "test:coverage": "node --test --experimental-test-coverage test/*.test.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc -p jsconfig.check.json",
    "check": "npm run lint && npm run typecheck && npm test && npm run frontend:build && npm run rust:lint && npm run rust:test",
    "app:dir": "npm run tauri -- build --no-bundle",
    "app:dist": "npm run tauri -- build",
    "app:dist:release": "node scripts/prepare-tauri-release.cjs --release && npm run tauri -- build --config dist/tauri-release.json && node scripts/tauri-release-artifacts.cjs",
    "db:sync:ludusavi": "node scripts/sync-ludusavi-manifest.js --report dist/ludusavi-sync-report.json",
    "db:sync:ludusavi:apply": "node scripts/sync-ludusavi-manifest.js --apply --report dist/ludusavi-sync-report.json",
    "db:sync:guides": "node scripts/sync-guide-catalog.js",
    "db:sync:xgp": "node scripts/sync-xgp-save-tools.js --report dist/xgp-save-tools-sync-report.json",
    "frontend:build": "npm run styles:build && cross-env NODE_ENV=production webpack --config webpack.renderer.config.js --mode production",
    "tauri": "node scripts/tauri.cjs",
    "rust:check": "node scripts/cargo.cjs check --manifest-path src-tauri/Cargo.toml",
    "rust:test": "node scripts/cargo.cjs test --manifest-path src-tauri/Cargo.toml",
    "rust:lint": "node scripts/cargo.cjs clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings"
  },
  "author": "leisurefire",
  "license": "GPL-3.0-only",
  "overrides": {
    "shell-quote": ">=1.8.4"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@lucide/icons": "^1.31.0",
    "@tailwindcss/cli": "^4.1.8",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "babel-loader": "^10.0.0",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "eslint": "^9.39.5",
    "globals": "^16.5.0",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "rimraf": "^6.0.1",
    "tailwind-scrollbar": "^4.0.2",
    "typescript": "^5.9.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "better-sqlite3": "^12.11.1",
    "js-yaml": "^4.3.1"
  }
}
