{
  "name": "opengamesave",
  "version": "0.6.22",
  "description": "Easily backup and restore your game saves anytime",
  "main": "dist/out/main/main.js",
  "scripts": {
    "tailwind:build": "npx tailwindcss -i ./src/renderer/styles.css -o ./src/renderer/tailwind-output.css --minify",
    "tailwind:watch": "npx tailwindcss -i ./src/renderer/styles.css -o ./src/renderer/tailwind-output.css --watch",
    "clean": "rimraf dist/out",
    "test": "node --test",
    "prestart": "npm run rebuild:electron-native",
    "start": "npm run clean && npm run tailwind:build && concurrently -k -s first -n \"TAILWIND,RENDERER,MAIN,ELECTRON\" \"npm:tailwind:watch\" \"webpack --watch --config webpack.renderer.config.js --mode development\" \"webpack --watch --config webpack.main.config.js --config webpack.preload.config.js --mode development\" \"wait-on dist/out/main/main.js dist/out/renderer/index.html dist/out/renderer/modal.html && electron .\"",
    "build": "npm run clean && cross-env NODE_ENV=production npm run tailwind:build && cross-env NODE_ENV=production webpack --config webpack.main.config.js --config webpack.preload.config.js --config webpack.renderer.config.js --mode production",
    "rebuild:electron-native": "node scripts/rebuild-electron-native.js",
    "package": "npm run build && npm run rebuild:electron-native && electron-builder --dir",
    "dist": "npm run build && npm run rebuild:electron-native && electron-builder",
    "db:sync:ludusavi": "node scripts/sync-ludusavi-manifest.js --report dist/ludusavi-sync-report.json",
    "db:sync:ludusavi:apply": "node scripts/sync-ludusavi-manifest.js --apply --report dist/ludusavi-sync-report.json",
    "postinstall": "electron-builder install-app-deps"
  },
  "build": {
    "extends": null,
    "icon": "./src/assets/logo.ico",
    "appId": "com.leisurefire.opengamesave",
    "productName": "OpenGameSave",
    "copyright": "Copyright © 2024-2026 leisurefire. Original work Copyright © 2024-2026 Yongcan Yang",
    "publish": null,
    "electronLanguages": [
      "en-US",
      "zh-CN"
    ],
    "files": [
      "dist/out/**/*",
      "!node_modules/7zip-bin/linux/**/*",
      "!node_modules/7zip-bin/mac/**/*",
      "!node_modules/7zip-bin/win/arm64/**/*",
      "!node_modules/7zip-bin/win/ia32/**/*",
      "!node_modules/better-sqlite3/bin/**/*",
      "!node_modules/better-sqlite3/deps/**/*",
      "!node_modules/better-sqlite3/src/**/*",
      "!node_modules/better-sqlite3/build/Release/obj/**/*",
      "!node_modules/better-sqlite3/build/Release/*.{exp,iobj,ipdb,lib,pdb}",
      "!node_modules/better-sqlite3/build/Release/test_extension.node"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "extraResources": [
      {
        "from": "./src/assets_export",
        "to": "assets_export"
      }
    ],
    "extraFiles": [
      {
        "from": "./database/database.db",
        "to": "./database/database.db"
      }
    ]
  },
  "author": "leisurefire",
  "license": "GPL-3.0-only",
  "overrides": {
    "shell-quote": ">=1.8.4"
  },
  "dependencies": {
    "7zip-bin": "^5.2.0",
    "axios": "^1.19.0",
    "better-sqlite3": "^12.11.1",
    "chokidar": "^4.0.1",
    "date-fns": "^4.1.0",
    "fs-extra": "^11.2.0",
    "glob": "^13.0.6",
    "i18next": "^25.3.2",
    "i18next-fs-backend": "^2.6.7",
    "js-yaml": "^4.3.1",
    "node-7z": "^3.0.0",
    "vdf-parser": "^1.2.1",
    "winreg": "^1.2.5"
  },
  "devDependencies": {
    "@babel/core": "^7.27.4",
    "@babel/preset-env": "^7.27.2",
    "@electron/rebuild": "^4.0.4",
    "@lucide/icons": "^1.31.0",
    "@tailwindcss/cli": "^4.1.8",
    "babel-loader": "^10.0.0",
    "concurrently": "^9.1.2",
    "copy-webpack-plugin": "^14.0.0",
    "cross-env": "^7.0.3",
    "css-loader": "^7.1.2",
    "electron": "^42.8.1",
    "electron-builder": "^26.11.1",
    "html-webpack-plugin": "^5.6.3",
    "mini-css-extract-plugin": "^2.9.2",
    "rimraf": "^6.0.1",
    "tailwind-scrollbar": "^4.0.2",
    "wait-on": "^8.0.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  },
  "allowScripts": {
    "electron@42.8.1": true,
    "better-sqlite3@12.11.1": true,
    "@parcel/watcher@2.5.1": true,
    "@tailwindcss/oxide@4.1.8": true,
    "electron-winstaller@5.4.0": false
  }
}
