{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "desktop",
  "description": "Local application windows; domain access is checked against immutable Rust window roles.",
  "windows": ["main", "settings-*", "about-*", "menu-*", "modal-*"],
  "permissions": [
    "core:event:allow-listen", "core:event:allow-unlisten",
    "core:window:allow-minimize", "core:window:allow-toggle-maximize",
    "core:window:allow-close", "core:window:allow-start-dragging",
    "core:window:allow-is-maximized", "core:window:allow-set-title"
  ]
}
